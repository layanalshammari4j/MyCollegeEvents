@{
    ViewData["Title"] = "النسخ الاحتياطي والاستعادة";
}

<div class="container-fluid" dir="rtl">
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-dark text-white text-center">
                    <h3>💾 النسخ الاحتياطي والاستعادة</h3>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- إنشاء نسخة احتياطية جديدة -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card bg-primary text-white">
                                <div class="card-body text-center">
                                    <h5 class="card-title">📦 إنشاء نسخة احتياطية جديدة</h5>
                                    <p class="card-text">إنشاء نسخة احتياطية من قاعدة البيانات الحالية</p>
                                    <form asp-action="CreateBackup" method="post" style="display: inline;">
                                        <button type="submit" class="btn btn-light btn-lg" 
                                                onclick="return confirm('هل تريدين إنشاء نسخة احتياطية جديدة؟')">
                                            💾 إنشاء نسخة احتياطية
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- قائمة النسخ الاحتياطية المتاحة -->
                    <div class="row">
                        <div class="col-12">
                            <h4 class="mb-3">📋 النسخ الاحتياطية المتاحة</h4>
                            
                            @if (ViewBag.Backups != null && ((IEnumerable<dynamic>)ViewBag.Backups).Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>اسم الملف</th>
                                                <th>تاريخ الإنشاء</th>
                                                <th>حجم الملف</th>
                                                <th>الإجراءات</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var backup in ViewBag.Backups)
                                            {
                                                <tr>
                                                    <td>
                                                        @backup.FileName
                                                        @if (backup.FileName.Contains("SimpleBackup"))
                                                        {
                                                            <span class="badge bg-info ms-2">نسخة مبسطة</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-success ms-2">نسخة كاملة</span>
                                                        }
                                                    </td>
                                                    <td>@backup.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                                    <td>
                                                        @if (backup.Size < 1024)
                                                        {
                                                            @($"{backup.Size} بايت")
                                                        }
                                                        else if (backup.Size < 1024 * 1024)
                                                        {
                                                            @($"{(backup.Size / 1024.0):F1} KB")
                                                        }
                                                        else
                                                        {
                                                            @($"{(backup.Size / 1024.0 / 1024.0):F2} MB")
                                                        }
                                                    </td>
                                                    <td>
                                                        <div class="btn-group" role="group">
                                                            <!-- استعادة -->
                                                            <form asp-action="RestoreBackup" method="post" style="display: inline;">
                                                                <input type="hidden" name="backupPath" value="@backup.Path" />
                                                                <button type="submit" class="btn btn-success btn-sm" 
                                                                        onclick="return confirm('تحذير: سيتم استبدال قاعدة البيانات الحالية بالكامل. هل تريدين المتابعة؟')">
                                                                    🔄 استعادة
                                                                </button>
                                                            </form>
                                                            
                                                            <!-- تحميل -->
                                                            <a href="@Url.Action("DownloadBackup", new { backupPath = backup.Path })" 
                                                               class="btn btn-info btn-sm">
                                                                📥 تحميل
                                                            </a>
                                                            
                                                            <!-- حذف -->
                                                            <form asp-action="DeleteBackup" method="post" style="display: inline;">
                                                                <input type="hidden" name="backupPath" value="@backup.Path" />
                                                                <button type="submit" class="btn btn-danger btn-sm" 
                                                                        onclick="return confirm('هل تريدين حذف هذه النسخة الاحتياطية؟')">
                                                                    🗑️ حذف
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info text-center">
                                    <h5>📢 لا توجد نسخ احتياطية</h5>
                                    <p>لم يتم إنشاء أي نسخ احتياطية بعد. قومي بإنشاء النسخة الاحتياطية الأولى.</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- معلومات مهمة -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="alert alert-warning">
                                <h5>⚠️ معلومات مهمة</h5>
                                <ul class="mb-0">
                                    <li><strong>النسخ الاحتياطي:</strong> يتم حفظ النسخ في مجلد Backups داخل المشروع</li>
                                    <li><strong>الاستعادة:</strong> ستقوم بحذف جميع البيانات الحالية واستبدالها بالنسخة المحددة</li>
                                    <li><strong>الأمان:</strong> احتفظي بنسخ احتياطية منتظمة في مكان آمن</li>
                                    <li><strong>التحميل:</strong> يمكنك تحميل النسخ الاحتياطية لحفظها خارجياً</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- أزرار التنقل -->
                    <div class="row mt-3">
                        <div class="col-12 text-center">
                            <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg px-5">
                                🔙 العودة للوحة التحكم
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        transition: transform 0.2s;
    }
    
    .card:hover {
        transform: translateY(-2px);
    }
    
    .btn-group .btn {
        margin-left: 2px;
    }
</style>
