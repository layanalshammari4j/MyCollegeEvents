@model IEnumerable<MyCollegeEvents.Models.Participant>
@{
    ViewData["Title"] = "إدارة المشاركات";
}

<div class="container-fluid" dir="rtl">
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h3 class="mb-0">👥 إدارة المشاركات</h3>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- فلاتر البحث -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <form method="get" asp-action="ViewParticipants">
                                        <div class="row">
                                            <div class="col-md-3">
                                                <label class="form-label">🎯 الفعالية</label>
                                                <select name="eventId" class="form-select">
                                                    <option value="">جميع الفعاليات</option>
                                                    @foreach (var eventItem in ViewBag.Events)
                                                    {
                                                        if (ViewBag.SelectedEventId != null && ViewBag.SelectedEventId == eventItem.EventID)
                                                        {
                                                            <option value="@eventItem.EventID" selected>@eventItem.Title</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@eventItem.EventID">@eventItem.Title</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">✅ حالة الموافقة</label>
                                                <select name="approved" class="form-select">
                                                    <option value="">الكل</option>
                                                    @if (ViewBag.SelectedApproved != null && ViewBag.SelectedApproved == true)
                                                    {
                                                        <option value="true" selected>مقبول</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="true">مقبول</option>
                                                    }
                                                    @if (ViewBag.SelectedApproved != null && ViewBag.SelectedApproved == false)
                                                    {
                                                        <option value="false" selected>في الانتظار</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="false">في الانتظار</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">🔍 البحث</label>
                                                <input type="text" name="searchTerm" class="form-control" 
                                                       placeholder="البحث في الاسم أو البريد الإلكتروني"
                                                       value="@ViewBag.SearchTerm" />
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label">&nbsp;</label>
                                                <button type="submit" class="btn btn-primary d-block w-100">
                                                    🔍 بحث
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- أزرار التصدير -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="btn-group" role="group">
                                <a href="@Url.Action("ExportExcel", new { eventId = ViewBag.SelectedEventId })" 
                                   class="btn btn-success">
                                    📗 تصدير Excel
                                </a>
                                <a href="@Url.Action("ExportPdf", new { eventId = ViewBag.SelectedEventId })" 
                                   class="btn btn-danger">
                                    📄 تصدير PDF
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- جدول المشاركات -->
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>الاسم</th>
                                        <th>الرقم الجامعي</th>
                                        <th>القسم</th>
                                        <th>الفعالية</th>
                                        <th>البريد الإلكتروني</th>
                                        <th>شاركت سابقاً</th>
                                        <th>تريد شهادة</th>
                                        <th>تاريخ التسجيل</th>
                                        <th>الحالة</th>
                                        <th>الإجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var participant in Model)
                                    {
                                        <tr>
                                            <td>@participant.Name</td>
                                            <td>@participant.UniversityID</td>
                                            <td>@participant.Department</td>
                                            <td>@participant.Event?.Title</td>
                                            <td>@participant.Email</td>
                                            <td>
                                                @if (participant.AttendedBefore)
                                                {
                                                    <span class="badge bg-info">نعم</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">لا</span>
                                                }
                                            </td>
                                            <td>
                                                @if (participant.WantCertificate)
                                                {
                                                    <span class="badge bg-warning">نعم</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">لا</span>
                                                }
                                            </td>
                                            <td>@participant.RegistrationDate.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                @if (participant.Approved)
                                                {
                                                    <span class="badge bg-success">مقبول</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">في الانتظار</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!participant.Approved)
                                                {
                                                    <form asp-action="ApproveParticipant" method="post" style="display: inline;">
                                                        <input type="hidden" name="id" value="@participant.ParticipantID" />
                                                        <button type="submit" class="btn btn-success btn-sm" 
                                                                onclick="return confirm('هل تريدين قبول هذه المشاركة؟')">
                                                            ✅ قبول
                                                        </button>
                                                    </form>
                                                }
                                                <form asp-action="RejectParticipant" method="post" style="display: inline;">
                                                    <input type="hidden" name="id" value="@participant.ParticipantID" />
                                                    <button type="submit" class="btn btn-danger btn-sm" 
                                                            onclick="return confirm('هل تريدين رفض هذه المشاركة؟')">
                                                        ❌ رفض
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-center">
                            <h5>📢 لا توجد مشاركات</h5>
                            <p>لا توجد مشاركات مطابقة للمعايير المحددة.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
