@model IEnumerable<MyCollegeEvents.Models.Event>
@{
    ViewData["Title"] = "الفعاليات المتاحة للتسجيل";
}

<div class="container" dir="rtl">
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white text-center">
                    <h2>📅 الفعاليات المتاحة للتسجيل</h2>
                    <p class="mb-0">اختاري الفعالية التي تريدين المشاركة فيها</p>
                </div>
                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (Model != null && Model.Any())
                    {
                        <div class="row">
                            @foreach (var eventItem in Model)
                            {
                                <div class="col-lg-6 col-md-12 mb-4">
                                    <div class="card h-100 border-primary">
                                        <div class="card-header bg-light">
                                            <h5 class="card-title text-primary mb-0">
                                                <i class="fas fa-calendar-alt"></i> @eventItem.Title
                                            </h5>
                                        </div>
                                        <div class="card-body">
                                            <p class="card-text">
                                                <strong>📝 الوصف:</strong><br>
                                                @eventItem.Description
                                            </p>
                                            
                                            <div class="row">
                                                <div class="col-6">
                                                    <p class="mb-2">
                                                        <strong>📅 التاريخ:</strong><br>
                                                        <span class="text-info">@eventItem.Date.ToString("dd/MM/yyyy")</span>
                                                    </p>
                                                </div>
                                                <div class="col-6">
                                                    <p class="mb-2">
                                                        <strong>🕐 الوقت:</strong><br>
                                                        <span class="text-info">@eventItem.Date.ToString("HH:mm")</span>
                                                    </p>
                                                </div>
                                            </div>
                                            
                                            <p class="mb-3">
                                                <strong>🏢 المنظمة:</strong>
                                                <span class="text-success">@eventItem.CreatedBy</span>
                                            </p>
                                            
                                            @if (eventItem.Date > DateTime.Now)
                                            {
                                                <div class="d-grid">
                                                    <a href="@Url.Action("Register", new { eventId = eventItem.EventID })" 
                                                       class="btn btn-primary btn-lg">
                                                        ✨ سجلي الآن
                                                    </a>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-grid">
                                                    <button class="btn btn-secondary btn-lg" disabled>
                                                        ⏰ انتهت فترة التسجيل
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                        <div class="card-footer text-muted text-center">
                                            <small>
                                                تم إنشاؤها في: @eventItem.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="alert alert-info">
                                <h4>📢 لا توجد فعاليات متاحة حالياً</h4>
                                <p>لم يتم إضافة أي فعاليات بعد. يرجى المراجعة لاحقاً.</p>
                                <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                                    🏠 العودة للصفحة الرئيسية
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    
    <!-- إحصائيات سريعة -->
    @if (Model != null && Model.Any())
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <div class="row">
                            <div class="col-md-4">
                                <h5 class="text-primary">📊 إجمالي الفعاليات</h5>
                                <h3 class="text-primary">@Model.Count()</h3>
                            </div>
                            <div class="col-md-4">
                                <h5 class="text-success">✅ متاحة للتسجيل</h5>
                                <h3 class="text-success">@Model.Count(e => e.Date > DateTime.Now)</h3>
                            </div>
                            <div class="col-md-4">
                                <h5 class="text-warning">⏰ انتهت فترة التسجيل</h5>
                                <h3 class="text-warning">@Model.Count(e => e.Date <= DateTime.Now)</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .card {
        transition: transform 0.2s;
    }
    
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    
    .btn-primary {
        background: linear-gradient(45deg, #007bff, #0056b3);
        border: none;
    }
    
    .btn-primary:hover {
        background: linear-gradient(45deg, #0056b3, #004085);
    }
</style>
